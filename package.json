{
  "name": "love-strings-dashboard",
  "version": "1.19.0-beta.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:dashboard-preferences": "node --experimental-strip-types scripts/test-dashboard-preferences.mjs",
    "test:date-input": "node --experimental-strip-types scripts/test-date-input.mjs",
    "test:metric-collector-eligibility": "node --experimental-strip-types scripts/test-metric-collector-eligibility.mjs",
    "check:instagram": "node scripts/import-instagram-metrics.mjs",
    "import:instagram": "node scripts/import-instagram-metrics.mjs --apply",
    "import:youtube": "node scripts/import-youtube-metrics.mjs --apply"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.108.2",
    "lucide-react": "1.21.0",
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "26.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.9",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.7.0"
}
