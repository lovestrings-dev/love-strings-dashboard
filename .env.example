NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# App access uses Supabase Auth. Keep public signup disabled and invite users
# from Supabase Authentication > Users.
# Public invitation/password-setup link origin; match the primary Vercel domain.
NEXT_PUBLIC_SITE_URL=https://www.artistdeck.app
CRON_SECRET=

# Server-only. Never expose this in browser code.
SUPABASE_SERVICE_ROLE_KEY=

# ArtistDeck Studio's server-only Google Cloud integration. Values are used by
# protected server routes only; do not prefix these with NEXT_PUBLIC_.
ADSTUDIO_GCP_PROJECT_ID=project-eda6605c-73e6-4361-9ad
ADSTUDIO_GCP_REGION=europe-west3
ADSTUDIO_STAGING_BUCKET=adstudio-staging-1023633877337
ADSTUDIO_RENDER_BUCKET=adstudio-renders-1023633877337
ADSTUDIO_RENDER_JOB=adstudio-ffmpeg-renderer

# Server-only Cloudinary credentials used by /api/media/images for managed uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_HANDLE=@LoveStringsBand
YOUTUBE_MUSIC_CHANNEL_ID=UCKlfg9lYKyMOg_Oiz-Zb1Fg

# Server-only Google OAuth connection used by General Settings.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# A base64url-encoded 32-byte key used to encrypt stored refresh tokens.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Server-only base64url-encoded 32-byte key for Meta OAuth token payloads.
META_TOKEN_ENCRYPTION_KEY=
# Server-only Meta App B credentials for Facebook Page OAuth.
META_FSTATS_APP_ID=
META_FSTATS_APP_SECRET=
# Server-only Facebook Login for Business Configuration ID. This config owns the
# App B Page/Instagram permission and asset-selection setup; do not also send scope.
META_FSTATS_CONFIG_ID=

# Server-only Meta App A credentials for Creator Instagram and Threads OAuth.
# Primary app/return origin. Provider callbacks stay on the existing Vercel host.
# APP_CANONICAL_ORIGIN must be an HTTPS origin, e.g. https://www.artistdeck.app.
APP_CANONICAL_ORIGIN=https://www.artistdeck.app
META_CREATOR_SOCIAL_APP_ID=
META_CREATOR_SOCIAL_APP_SECRET=
META_CREATOR_SOCIAL_INSTAGRAM_APP_ID=
META_CREATOR_SOCIAL_INSTAGRAM_APP_SECRET=
META_CREATOR_SOCIAL_THREADS_APP_ID=
META_CREATOR_SOCIAL_THREADS_APP_SECRET=

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_ARTIST_ID=4CESELwcVlIPnfiWuaxRbF
